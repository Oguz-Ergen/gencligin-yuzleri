---
import Base from '../layouts/Base.astro';
import DocCard from '../components/DocCard.astro';
import DuyuruCard from '../components/DuyuruCard.astro';
import YaziCard from '../components/YaziCard.astro';
import { getSettings, getDonemler, getBelgeler, getDuyurular, getYazilar } from '../lib/content';
import { t, routes, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];

const [settings, donemler, belgeler, duyurular, yazilar] = await Promise.all([
  getSettings(lang),
  getDonemler(lang),
  getBelgeler(lang),
  getDuyurular(lang, 3),
  getYazilar(lang, 3),
]);

const periodColors = ['var(--p1)', 'var(--p2)', 'var(--p3)'];
// Mavi dönemde metin beyaz; turuncu ve nane dönemde lacivert.
const periodText = ['var(--ink)', '#fff', 'var(--ink)'];
const pc = (n: number) => (n - 1) % 3;

const words = settings.slogan.split(/\s+/).filter(Boolean);
const topics = belgeler.map((b) => ({ who: b.label ?? '', what: b.title, href: b.fileUrl }));
const cities = [...new Set(donemler.flatMap((d) => d.cities))];
const photos = [...settings.heroImages, ...settings.aboutImages].slice(0, 5);
const blobs = ['var(--fire)', 'var(--mint)', 'var(--violet)', 'var(--blue)'];
const blobText = ['var(--ink)', 'var(--ink)', 'var(--ink)', '#fff'];
const lower = (x: string) => x.toLocaleLowerCase(s.locale);
const tilt = (i: number) => `${[-3, 2.5, -1.5, 3, -2.5][i % 5]}deg`;
---

<Base paths={{ tr: routes.home.tr, en: routes.home.en }}>
  <!-- Giriş: pankart başlık ve forumdan akan sohbet -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="poster slam" aria-label={settings.slogan}>
          {words.map((w, i) => <span aria-hidden="true" style={`--i:${i}`}>{w}</span>)}
        </h1>
        <p class="hero-text">{settings.heroText}</p>
        <div class="hero-actions">
          <a class="btn btn--fire" href={`#${s.ids.periods}`}>{s.hero.primary}</a>
          <a class="btn btn--line" href={routes.belgeler[lang]}>{s.hero.secondary}</a>
        </div>
      </div>

      {topics.length > 0 && (
        <div class="chat">
          <p class="chat-title"><span class="dot" aria-hidden="true"></span>{s.hero.chat}</p>
          <ul class="chat-feed" aria-live="off">
            {topics.slice(0, 5).map((t, i) => (
              <li class:list={['msg', { right: i % 2 === 1 }]} style={`--fill:${blobs[i % 3]}`}>
                <a href={t.href} target="_blank" rel="noopener">
                  {t.who && <span class="who">{t.who}</span>}
                  <span class="what">{t.what}</span>
                </a>
              </li>
            ))}
          </ul>
          <script type="application/json" id="topics" set:html={JSON.stringify(topics)} />
        </div>
      )}
    </div>
  </section>

  <!-- Slogan bantları -->
  <div class="bands" aria-hidden="true">
    {photos[0] && <img class="sticker s1" src={photos[0].url(720)} alt="" />}
    {photos[1] && <img class="sticker s2" src={photos[1].url(720)} alt="" />}
    <div class="ticker band band--fire" style="--speed:38s">
      <div class="ticker-track">
        {[0, 1].map(() => <span lang="tr">{cities.map((c) => <>{c}<i>✺</i></>)}</span>)}
      </div>
    </div>
    <div class="ticker ticker--rev band band--violet" style="--speed:60s">
      <div class="ticker-track">
        {[0, 1].map(() => (
          <span>
            <><span lang={lang}>{s.hashtag}</span><i>✺</i></>
            {topics.map((t) => <>{t.what}<i>✺</i></>)}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Sayılar ve hakkımızda -->
  <section class="about" id={s.ids.about}>
    <div class="wrap">
      {settings.stats.length > 0 && (
        <p class="tally" data-reveal style="--tilt:0deg">
          {s.since}{' '}
          {settings.stats.map((s, i) => (
            <>
              <span class="num" style={`--bg:${blobs[i % 4]}; --fg:${blobText[i % 4]}; --r:${i % 2 ? 3 : -3}deg`}>
                <span data-count={s.value}>{s.value}</span>
              </span>{' '}
              {lower(s.label)}{i < settings.stats.length - 1 ? ', ' : '.'}
            </>
          ))}
        </p>
      )}

      <div class="about-grid">
        <div data-reveal style="--tilt:0deg">
          <h2>{settings.aboutTitle}</h2>
          {settings.aboutText.map((p) => <p>{p}</p>)}
        </div>
        {photos.length > 0 && (
          <div class="wall" aria-label={s.photos}>
            {photos.map((img, i) => (
              <figure data-reveal style={`--tilt:${tilt(i)}`}>
                <img src={img.url(720)} alt={img.alt} loading="lazy" />
              </figure>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Dönemler -->
  <section id={s.ids.periods} aria-label={s.periods}>
    {donemler.map((d) => {
      const docs = belgeler.filter((b) => b.donem === d.number);
      const k = pc(d.number);
      return (
        <article class="period" id={`donem-${d.number}`} style={`--c:${periodColors[k]}; --on:${periodText[k]}`}>
          <span class="giant" aria-hidden="true">{d.number}</span>
          <div class="wrap period-inner">
            <p class="period-name">{s.period(d.number)}{d.years && <>, {d.years}</>}</p>
            <h2 class="poster period-title" data-reveal style="--tilt:-1.5deg">{d.title}</h2>
            <div class="period-cols">
              <div class="period-text">
                {d.intro.map((p) => <p>{p}</p>)}
              </div>
              {d.cities.length > 0 && (
                <ul class="cities" aria-label={s.cities}>
                  {d.cities.map((c, i) => <li style={`--r:${tilt(i)}`}>{c}</li>)}
                </ul>
              )}
            </div>

            {d.activities.length > 0 && (
              <ul class="activities">
                {d.activities.map((a, i) => (
                  <li data-reveal style={`--tilt:${tilt(i)}`}>
                    <h3>{a.title}</h3>
                    <p>{a.text}</p>
                  </li>
                ))}
              </ul>
            )}

            {d.highlight && (
              <blockquote class="outcome" data-reveal style="--tilt:2deg">
                <p class="outcome-title">{d.highlight.title}</p>
                <p>{d.highlight.text}</p>
              </blockquote>
            )}

            {docs.length > 0 && (
              <div class="docs">
                <h3>{s.periodDocs}</h3>
                <div class="doc-grid">
                  {docs.map((b, i) => (
                    <div class="pin" style={`--r:${tilt(i)}`}><DocCard belge={b} lang={lang} /></div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </article>
      );
    })}
  </section>

  {yazilar.length > 0 && (
    <section class="blog">
      <div class="wrap">
        <div class="news-head">
          <h2 class="poster">{s.blog.latest}</h2>
          <a href={routes.blog[lang]}>{s.blog.all}</a>
        </div>
        <div class="news-grid">
          {yazilar.map((y, i) => <YaziCard yazi={y} lang={lang} tint={['var(--mint)', 'var(--fire)', 'var(--violet)'][i % 3]} />)}
        </div>
      </div>
    </section>
  )}

  {duyurular.length > 0 && (
    <section class="news">
      <div class="wrap">
        <div class="news-head">
          <h2>{s.news}</h2>
          <a href={routes.duyurular[lang]}>{s.allNews}</a>
        </div>
        <div class="news-grid">{duyurular.map((d) => <DuyuruCard duyuru={d} lang={lang} />)}</div>
      </div>
    </section>
  )}

  <!-- Katıl -->
  <section class="join" id={s.ids.contact}>
    <div class="ticker join-ticker" style="--speed:22s" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => <span>{[0, 1, 2, 3].map(() => <>{s.join.chant}<i>✺</i></>)}</span>)}
      </div>
    </div>
    <div class="wrap join-inner">
      <h2 class="visually-hidden">{s.join.chant}</h2>
      <p>{s.join.text}</p>
      <div class="join-actions">
        {settings.volunteerUrl && (
          <a class="btn" href={settings.volunteerUrl} target="_blank" rel="noopener">{s.volunteer}</a>
        )}
        {settings.email && <a class="btn btn--line" href={`mailto:${settings.email}`}>{settings.email}</a>}
      </div>
    </div>
  </section>
</Base>

<script>
  // Forum sohbeti: önce "yazıyor…", sonra konu balonu düşer; döngü sürer.
  const feed = document.querySelector<HTMLUListElement>('.chat-feed');
  const data = document.getElementById('topics');
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (feed && data && !calm) {
    const topics: { who: string; what: string; href: string }[] = JSON.parse(data.textContent || '[]');
    const fills = ['var(--fire)', 'var(--mint)', 'var(--violet)', '#fff'];
    const MAX = 5;
    let n = 0;
    feed.replaceChildren();

    const next = () => {
      const t = topics[n % topics.length];
      const li = document.createElement('li');
      li.className = `msg typing${n % 2 === 1 ? ' right' : ''}`;
      li.style.setProperty('--fill', fills[n % fills.length]);
      li.innerHTML = '<span class="dots"><b></b><b></b><b></b></span>';
      feed.append(li);
      while (feed.children.length > MAX) feed.firstElementChild!.remove();
      setTimeout(() => {
        li.classList.remove('typing');
        const a = document.createElement('a');
        a.href = t.href;
        a.target = '_blank';
        a.rel = 'noopener';
        if (t.who) {
          const who = document.createElement('span');
          who.className = 'who';
          who.textContent = t.who;
          a.append(who);
        }
        const what = document.createElement('span');
        what.className = 'what';
        what.textContent = t.what;
        a.append(what);
        li.replaceChildren(a);
        n++;
        setTimeout(next, 1500);
      }, 900);
    };
    next();
  }
</script>

<style>
  /* ——— Giriş ——— */
  .hero {
    position: relative;
    background: var(--blue);
    color: #fff;
    padding: clamp(40px, 7vw, 88px) 0 clamp(96px, 12vw, 150px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .slam { font-size: clamp(4.2rem, 13vw, 11.5rem); margin: 0 0 0.25em; }
  .slam span {
    display: block;
    width: fit-content;
    animation: slam 0.55s cubic-bezier(0.2, 1.4, 0.4, 1) both;
    animation-delay: calc(0.1s + var(--i) * 0.16s);
  }
  .slam span:nth-child(2) { margin-left: 0.5em; }
  @keyframes slam {
    0% { opacity: 0; transform: scale(1.8) rotate(-8deg); filter: blur(6px); }
    70% { opacity: 1; transform: scale(0.96) rotate(1deg); filter: none; }
    100% { opacity: 1; transform: none; }
  }
  .hero-text { font-size: clamp(1.15rem, 1.6vw, 1.35rem); color: var(--blue-soft); max-width: 40ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero .btn--line { color: #fff; }

  /* Sohbet */
  .chat {
    background: rgb(14 20 64 / 0.35);
    border-radius: 34px 34px 34px 8px;
    padding: 18px 18px 22px;
    min-height: 470px;
    display: flex;
    flex-direction: column;
    transform: rotate(1.5deg);
  }
  .chat-title { display: flex; align-items: center; gap: 10px; font-weight: 650; margin: 0 0 14px; color: var(--blue-soft); }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--mint); animation: pulse 1.6s infinite; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgb(63 211 181 / 0.7); }
    70% { box-shadow: 0 0 0 10px rgb(63 211 181 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(63 211 181 / 0); }
  }
  .chat-feed {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    overflow: hidden;
  }
  .chat-feed :global(.msg) {
    align-self: flex-start;
    max-width: 86%;
    animation: pop 0.45s cubic-bezier(0.2, 1.5, 0.4, 1) both;
    transform-origin: bottom left;
  }
  .chat-feed :global(.msg.right) { align-self: flex-end; transform-origin: bottom right; }
  .chat-feed :global(.msg a),
  .chat-feed :global(.msg .dots) {
    display: block;
    background: var(--fill);
    color: var(--ink);
    padding: 10px 16px 11px;
    border-radius: var(--bubble);
    text-decoration: none;
    line-height: 1.25;
  }
  .chat-feed :global(.msg.right a),
  .chat-feed :global(.msg.right .dots) { border-radius: var(--bubble-r); }
  .chat-feed :global(.msg a:hover .what) { text-decoration: underline; }
  .chat-feed :global(.who) { display: block; font-size: 0.82rem; font-weight: 750; margin-bottom: 2px; opacity: 0.75; }
  .chat-feed :global(.what) { font-weight: 650; font-size: 1.05rem; }
  .chat-feed :global(.msg .dots) { display: inline-flex; gap: 5px; padding: 14px 18px; }
  .chat-feed :global(.dots b) { width: 8px; height: 8px; border-radius: 50%; background: var(--ink); opacity: 0.4; animation: blink 1s infinite; }
  .chat-feed :global(.dots b:nth-child(2)) { animation-delay: 0.15s; }
  .chat-feed :global(.dots b:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes blink { 50% { opacity: 1; transform: translateY(-3px); } }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.6) translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .chat { min-height: 400px; transform: none; }
  }

  /* ——— Slogan bantları ——— */
  .bands { position: relative; margin-top: -64px; z-index: 2; padding-bottom: 24px; }
  .band {
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 4.5vw, 3.6rem);
    line-height: 1;
    color: var(--ink);
    padding: 14px 0 12px;
    width: 106%;
    margin-left: -3%;
  }
  .band span { padding-right: 0.4em; }
  .band i { font-style: normal; margin: 0 0.4em; display: inline-block; }
  .band--fire { background: var(--fire); transform: rotate(-2.5deg); }
  .band--violet { background: var(--violet); transform: rotate(1.5deg); margin-top: -6px; font-size: clamp(1.3rem, 3vw, 2.3rem); }
  .band--fire i { animation: spin 6s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .sticker {
    position: absolute;
    z-index: 3;
    width: clamp(160px, 18vw, 260px);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 7px solid #fff;
    border-radius: 6px;
    box-shadow: 0 18px 40px rgb(14 20 64 / 0.3);
    animation: float 6s ease-in-out infinite;
  }
  .s1 { left: 44%; top: -130px; width: clamp(150px, 15vw, 220px); --r: -8deg; }
  .s2 { right: 5%; top: 40px; --r: 7deg; animation-delay: -3s; }
  @keyframes float {
    0%, 100% { transform: rotate(var(--r)) translateY(0); }
    50% { transform: rotate(calc(var(--r) * -0.4)) translateY(-14px); }
  }
  @media (max-width: 900px) { .sticker { display: none; } }

  /* ——— Sayılar ve hakkımızda ——— */
  .about { padding: clamp(72px, 10vw, 136px) 0 clamp(72px, 10vw, 128px); overflow: hidden; }
  .tally {
    font-size: clamp(2rem, 5.2vw, 4.4rem);
    font-weight: 700;
    font-stretch: 82%;
    line-height: 1.22;
    letter-spacing: -0.02em;
    max-width: 22ch;
    margin: 0 0 clamp(56px, 8vw, 104px);
  }
  .num {
    display: inline-block;
    background: var(--bg);
    color: var(--fg);
    padding: 0 0.22em 0.04em;
    border-radius: 0.38em 0.38em 0.38em 0.08em;
    transform: rotate(var(--r));
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .about-grid h2 { font-size: clamp(2.2rem, 4.6vw, 3.6rem); }
  .about-grid p { color: var(--ink-soft); font-size: 1.12rem; }

  .wall { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-rows: clamp(70px, 9vw, 120px); }
  .wall figure {
    margin: 0;
    border: 6px solid #fff;
    border-radius: 4px;
    box-shadow: 0 14px 30px rgb(14 20 64 / 0.18);
    overflow: hidden;
    transform: rotate(var(--tilt));
  }
  .js .wall figure[data-reveal] { transition: transform 0.35s cubic-bezier(0.3, 1.5, 0.5, 1), opacity 0.7s ease; }
  .js .wall figure.in { transform: rotate(var(--tilt)); }
  .wall figure:hover { transform: rotate(0deg) scale(1.06); z-index: 2; }
  .js .wall figure.in:hover { transform: rotate(0deg) scale(1.06); }
  .wall img { width: 100%; height: 100%; object-fit: cover; }
  .wall figure:nth-child(1) { grid-column: 1 / 5; grid-row: 1 / 4; }
  .wall figure:nth-child(2) { grid-column: 4 / 7; grid-row: 1 / 3; margin-top: 24px; }
  .wall figure:nth-child(3) { grid-column: 5 / 7; grid-row: 3 / 5; }
  .wall figure:nth-child(4) { grid-column: 1 / 3; grid-row: 4 / 6; margin-top: -20px; }
  .wall figure:nth-child(5) { grid-column: 3 / 5; grid-row: 4 / 6; }
  @media (max-width: 860px) { .about-grid { grid-template-columns: 1fr; } }

  /* ——— Dönemler ——— */
  .period {
    position: relative;
    background: var(--c);
    color: var(--on);
    padding: clamp(72px, 10vw, 128px) 0;
    overflow: hidden;
  }
  .giant {
    position: absolute;
    right: -0.06em;
    top: 50%;
    font-size: clamp(22rem, 60vw, 54rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.7;
    color: var(--on);
    opacity: 0.1;
    pointer-events: none;
    translate: 0 -50%;
  }
  @supports (animation-timeline: view()) {
    .giant { animation: drift linear both; animation-timeline: view(); }
    @keyframes drift {
      from { transform: translateY(18%) rotate(-6deg); }
      to { transform: translateY(-18%) rotate(4deg); }
    }
  }
  .period-inner { position: relative; }
  .period-name { font-weight: 750; font-size: 1.1rem; margin: 0 0 12px; }
  .period-title { font-size: clamp(3rem, 8.5vw, 7rem); max-width: 14ch; margin-bottom: 0.4em; }
  .period-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .period-text p { font-size: 1.12rem; }
  .cities { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .cities li {
    background: var(--ink);
    color: #fff;
    font-weight: 700;
    padding: 6px 14px 7px;
    border-radius: var(--bubble);
    transform: rotate(var(--r));
    transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .period:nth-child(2) .cities li { background: #fff; color: var(--ink); }
  .cities li:hover { transform: rotate(0) scale(1.12); }
  @media (max-width: 860px) { .period-cols { grid-template-columns: 1fr; } }

  .activities {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .activities li {
    background: var(--paper);
    color: var(--ink);
    padding: 24px 26px;
    border-radius: var(--bubble);
  }
  .activities li:nth-child(even) { border-radius: var(--bubble-r); }
  .activities h3 { font-size: 1.25rem; line-height: 1.25; margin-bottom: 8px; }
  .activities p { margin: 0; color: var(--ink-soft); }
  @media (max-width: 760px) { .activities { grid-template-columns: 1fr; } }

  .outcome {
    margin: 48px 0 0;
    padding: clamp(26px, 4vw, 44px);
    background: var(--ink);
    color: #fff;
    border-radius: 36px 36px 36px 8px;
    max-width: 860px;
  }
  .outcome-title {
    font-size: clamp(1.8rem, 3.8vw, 3rem);
    font-weight: 800;
    font-stretch: 78%;
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin-bottom: 0.45em;
    text-wrap: balance;
  }
  .outcome p:last-child { margin: 0; color: #d3d9f5; }

  .docs { margin-top: 56px; }
  .docs > h3 { font-size: 1.3rem; margin-bottom: 22px; }
  .doc-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px 24px; max-width: 900px; }
  .pin { transform: rotate(var(--r)); transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1); }
  .pin:hover { transform: rotate(0) translateY(-8px) scale(1.04); }
  .pin :global(.label) { color: inherit; opacity: 0.8; }
  @media (max-width: 960px) { .doc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* ——— Blog ——— */
  .blog { background: var(--mist); padding: clamp(72px, 10vw, 120px) 0; }
  .blog .poster { font-size: clamp(3rem, 9vw, 7rem); }

  /* ——— Duyurular ——— */
  .news { padding: clamp(72px, 10vw, 120px) 0; }
