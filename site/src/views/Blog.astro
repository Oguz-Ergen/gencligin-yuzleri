---
import Base from '../layouts/Base.astro';
import YaziCard from '../components/YaziCard.astro';
import { getYazilar } from '../lib/content';
import { t, routes, anchor, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang].blog;
const yazilar = await getYazilar(lang);
const [first, ...rest] = yazilar;
const tints = ['var(--mint)', 'var(--fire)', 'var(--violet)'];
---

<Base title={s.title} description={s.description} paths={{ tr: routes.blog.tr, en: routes.blog.en }}>
  <header class="page-head blog-head">
    <div class="wrap">
      <h1>{s.title}</h1>
      <p>{s.intro}</p>
    </div>
  </header>
  <section class="page-body">
    <div class="wrap">
      {yazilar.length === 0 ? (
        <p class="empty">{s.empty} <a href={anchor(lang, 'contact')}>{s.emptyLink}</a>.</p>
      ) : (
        <>
          <YaziCard yazi={first} lang={lang} featured tint="var(--fire)" />
          {rest.length > 0 && (
            <div class="grid">
              {rest.map((y, i) => <YaziCard yazi={y} lang={lang} tint={tints[i % tints.length]} />)}
            </div>
          )}
        </>
      )}
    </div>
  </section>
</Base>

<style>
  .blog-head { background: var(--violet); color: var(--ink); }
  .blog-head p { color: var(--ink); }
  .empty { font-size: 1.2rem; color: var(--ink-soft); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 28px; margin-top: clamp(56px, 7vw, 88px); }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
