---
import Base from '../layouts/Base.astro';
import YaziCard from '../components/YaziCard.astro';
import { formatDate, getYazilar, type Yazi } from '../lib/content';
import { t, routes, yaziPath, categoryLabel, type Lang } from '../i18n';

interface Props { lang: Lang; yazi: Yazi }
const { lang, yazi } = Astro.props;
const s = t[lang].blog;
const more = (await getYazilar(lang, 4)).filter((y) => y.slug !== yazi.slug).slice(0, 3);
const tints = ['var(--mint)', 'var(--fire)', 'var(--violet)'];
---

<Base
  title={yazi.title}
  description={yazi.excerpt}
  image={yazi.image?.url(1200)}
  paths={{ tr: yaziPath('tr', yazi.slug), en: yaziPath('en', yazi.slug) }}
>
  <article>
    <header class="post-head">
      <div class="wrap narrow">
        <a class="back" href={routes.blog[lang]}>{s.back}</a>
        {yazi.category && <p class="cat">{categoryLabel(lang, yazi.category)}</p>}
        <h1>{yazi.title}</h1>
        <p class="meta">
          {yazi.author && <span>{s.by} <strong>{yazi.author}</strong></span>}
          <time datetime={yazi.date}>{formatDate(yazi.date, lang)}</time>
          <span>{s.readMin(yazi.readingMinutes)}</span>
        </p>
      </div>
    </header>
    <div class="wrap narrow body">
      {yazi.image && (
        <img class="cover" src={yazi.image.url(1400)} alt={yazi.image.alt} width="1400" height="875" />
      )}
      {yazi.excerpt && <p class="lead">{yazi.excerpt}</p>}
      <div class="prose" set:html={yazi.bodyHtml} />
    </div>
  </article>

  {more.length > 0 && (
    <section class="more">
      <div class="wrap">
        <h2>{s.more}</h2>
        <div class="grid">{more.map((y, i) => <YaziCard yazi={y} lang={lang} tint={tints[i % tints.length]} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .narrow { max-width: 860px; }
  .post-head { background: var(--blue); color: #fff; padding: clamp(40px, 6vw, 72px) 0 clamp(120px, 14vw, 180px); }
  .back { color: #fff; font-weight: 650; }
  .cat {
    display: block;
    width: fit-content;
    margin: 28px 0 0;
    background: var(--fire);
    color: var(--ink);
    font-weight: 750;
    padding: 4px 14px 5px;
    border-radius: 14px 14px 14px 4px;
    transform: rotate(-3deg);
  }
  .post-head h1 {
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: -0.01em;
    margin: 18px 0 22px;
  }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 20px; color: var(--blue-soft); margin: 0; }
  .meta strong { color: #fff; }
  .body { margin-top: clamp(-150px, -11vw, -90px); padding-bottom: clamp(64px, 9vw, 112px); }
  .cover {
    width: 100%;
    height: auto;
    border: 8px solid #fff;
    border-radius: 10px;
    box-shadow: 0 24px 50px rgb(14 20 64 / 0.25);
    transform: rotate(-1deg);
    margin-bottom: 44px;
  }
  .body .lead { font-size: clamp(1.25rem, 2vw, 1.5rem); color: var(--ink); font-weight: 550; margin-bottom: 1.4em; }
  .body:not(:has(.cover)) { margin-top: clamp(-90px, -7vw, -60px); }
  .body:not(:has(.cover)) .lead { background: #fff; padding: 28px 30px; border-radius: 26px 26px 26px 6px; box-shadow: 0 18px 40px rgb(14 20 64 / 0.15); }
  .more { background: var(--mist); padding: clamp(64px, 9vw, 112px) 0; }
  .more h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin-bottom: 32px; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 28px; }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr; } }
</style>
