---
import Base from '../../layouts/Base.astro';
import DuyuruCard from '../../components/DuyuruCard.astro';
import { getDuyurular } from '../../lib/content';

const duyurular = await getDuyurular();
---

<Base title="Duyurular" description="Gençliğin Yüzleri etkinlik, çağrı ve haberleri.">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Güncel</span>
      <h1 class="page-title">Duyurular</h1>
      {duyurular.length === 0 ? (
        <p class="lead">Şu an yayında bir duyuru yok. Yeni forum ve etkinlik duyuruları burada yer alacak.</p>
      ) : (
        <div class="grid">{duyurular.map((d) => <DuyuruCard duyuru={d} />)}</div>
      )}
    </div>
  </section>
</Base>

<style>
  .page-title { font-size: clamp(2.6rem, 7vw, 4.8rem); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 36px; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
