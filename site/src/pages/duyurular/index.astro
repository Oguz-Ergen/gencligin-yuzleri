---
import Base from '../../layouts/Base.astro';
import DuyuruCard from '../../components/DuyuruCard.astro';
import { getDuyurular } from '../../lib/content';

const duyurular = await getDuyurular();
---

<Base title="Duyurular" description="Gençliğin Yüzleri etkinlik, çağrı ve haberleri.">
  <header class="page-head">
    <div class="wrap">
      <h1>Duyurular</h1>
      <p>Forumlar, etkinlikler, çağrılar ve gençleri ilgilendiren haberler.</p>
    </div>
  </header>
  <section class="page-body">
    <div class="wrap">
      {duyurular.length === 0 ? (
        <p class="empty">Şu an yayında duyuru yok. Yeni forum ve etkinliklerden haberdar olmak için <a href="/#iletisim">bize yaz</a>.</p>
      ) : (
        <div class="grid">{duyurular.map((d) => <DuyuruCard duyuru={d} />)}</div>
      )}
    </div>
  </section>
</Base>

<style>
  .empty { font-size: 1.2rem; color: var(--ink-soft); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 24px; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
