---
import { formatDate, type Yazi } from '../lib/content';
import { t, yaziPath, categoryLabel, type Lang } from '../i18n';

interface Props { yazi: Yazi; lang?: Lang; featured?: boolean; tint?: string }
const { yazi, lang = 'tr', featured = false, tint = 'var(--violet)' } = Astro.props;
const s = t[lang].blog;
---

<article class:list={['post', { featured }]} style={`--tint:${tint}`}>
  <div class="media">
    {yazi.image
      ? <img src={yazi.image.url(featured ? 1400 : 720)} alt={yazi.image.alt} loading="lazy" />
      : <span class="noimg" aria-hidden="true">✺</span>}
    {yazi.category && <span class="cat">{categoryLabel(lang, yazi.category)}</span>}
  </div>
  <div class="text">
    <h3><a href={yaziPath(lang, yazi.slug)}>{yazi.title}</a></h3>
    {yazi.excerpt && <p class="excerpt">{yazi.excerpt}</p>}
    <p class="meta">
      {yazi.author && <span>{s.by} {yazi.author}</span>}
      <time datetime={yazi.date}>{formatDate(yazi.date, lang)}</time>
      <span>{s.readMin(yazi.readingMinutes)}</span>
    </p>
  </div>
</article>

<style>
  .post { position: relative; display: flex; flex-direction: column; gap: 18px; }
  .media {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 22px 22px 22px 6px;
    overflow: hidden;
    background: var(--tint);
    transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .post:hover .media { transform: rotate(-1.5deg) scale(1.02); }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .noimg { display: grid; place-items: center; height: 100%; font-size: 5rem; color: var(--ink); opacity: 0.35; }
  .cat {
    position: absolute;
    left: 14px;
    top: 14px;
    background: var(--ink);
    color: #fff;
    font-weight: 700;
    font-size: 0.88rem;
    padding: 4px 12px 5px;
    border-radius: 14px 14px 14px 4px;
    transform: rotate(-3deg);
  }
  h3 { font-size: clamp(1.35rem, 2vw, 1.65rem); margin-bottom: 8px; }
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .post:hover h3 a { text-decoration: underline; }
  .excerpt { color: var(--ink-soft); margin-bottom: 10px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 0.92rem; color: var(--ink-soft); margin: 0; }

  /* Öne çıkan yazı: kapak kendi oranında ve kırpılmadan üstte, altında renkli metin bloğu.
     Kapaklar çoğu zaman üzerinde yazı olan 16:9 görseller; kırpılmaları başlığı keser. */
  .featured { gap: 0; }
  .featured .media { aspect-ratio: 16 / 9; border-radius: 34px 34px 0 0; }
  .featured:hover .media { transform: none; }
  .featured .media:has(.noimg) { background: var(--blue); }
  .featured .noimg { color: #fff; font-size: 9rem; }
  .featured .text {
    background: var(--tint);
    color: var(--ink);
    padding: clamp(26px, 4vw, 48px);
    border-radius: 0 0 34px 8px;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 14px clamp(24px, 4vw, 56px);
    align-items: end;
  }
  .featured h3 {
    grid-row: span 2;
    margin: 0;
    font-size: clamp(2.2rem, 4.6vw, 4rem);
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    line-height: 0.92;
    letter-spacing: -0.01em;
  }
  .featured .excerpt, .featured .meta { color: var(--ink); }
  .featured .excerpt { font-size: 1.12rem; margin: 0; }
  @media (max-width: 860px) {
    .featured .media { border-radius: 26px 26px 0 0; }
    .featured .text { grid-template-columns: 1fr; border-radius: 0 0 26px 6px; }
    .featured h3 { grid-row: auto; }
  }
</style>
