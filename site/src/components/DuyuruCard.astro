---
import { formatDate, type Duyuru } from '../lib/content';

interface Props { duyuru: Duyuru }
const { duyuru } = Astro.props;
---

<article class="item">
  {duyuru.image && (
    <img src={duyuru.image.url(720)} alt={duyuru.image.alt} loading="lazy" width="720" height="405" />
  )}
  <p class="meta">
    {duyuru.category && <span class="tag">{duyuru.category}</span>}
    <time datetime={duyuru.date}>{formatDate(duyuru.date)}</time>
  </p>
  <h3><a href={`/duyurular/${duyuru.slug}`}>{duyuru.title}</a></h3>
  {duyuru.summary && <p class="summary">{duyuru.summary}</p>}
</article>

<style>
  .item { position: relative; }
  img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 14px; margin-bottom: 16px; }
  .meta { display: flex; align-items: center; gap: 10px; font-size: 0.92rem; color: var(--ink-soft); margin-bottom: 8px; }
  .tag { background: var(--mist); color: var(--ink); font-weight: 600; padding: 2px 10px 3px; border-radius: 12px 12px 12px 3px; }
  h3 { font-size: 1.45rem; margin-bottom: 8px; }
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .item:hover h3 a { text-decoration: underline; }
  .summary { color: var(--ink-soft); margin: 0; }
</style>
