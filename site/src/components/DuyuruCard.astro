---
import { formatDate, type Duyuru } from '../lib/content';

interface Props { duyuru: Duyuru }
const { duyuru } = Astro.props;
---

<article class="card">
  {duyuru.image && (
    <img src={duyuru.image.url(720)} alt={duyuru.image.alt} loading="lazy" width="720" height="405" />
  )}
  <div class="body">
    <p class="meta">
      <time datetime={duyuru.date}>{formatDate(duyuru.date)}</time>
      {duyuru.category && <span> · {duyuru.category}</span>}
    </p>
    <h3><a href={`/duyurular/${duyuru.slug}`}>{duyuru.title}</a></h3>
    {duyuru.summary && <p class="summary">{duyuru.summary}</p>}
  </div>
</article>

<style>
  .card {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgb(29 34 64 / 0.12); }
  img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .body { padding: 20px 22px 24px; }
  .meta { font-size: 0.85rem; color: var(--ink-soft); margin-bottom: 8px; }
  h3 { font-size: 1.35rem; margin-bottom: 10px; }
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .summary { color: var(--ink-soft); margin: 0; font-size: 0.98rem; }
</style>
