---
const links = [
  { href: '/#hakkimizda', label: 'Hakkımızda' },
  { href: '/#donemler', label: 'Dönemler' },
  { href: '/belgeler', label: 'Politika Belgeleri' },
  { href: '/duyurular', label: 'Duyurular' },
  { href: '/#iletisim', label: 'İletişim' },
];
const path = Astro.url.pathname;
const { volunteerUrl } = Astro.props as { volunteerUrl?: string };
---

<header class="header">
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Gençliğin Yüzleri ana sayfa">
      <img src="/arsiv/gorseller/gy-logo.png" alt="Gençliğin Yüzleri" width="449" height="281" />
    </a>

    <nav aria-label="Ana menü" class="nav-desktop">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    {volunteerUrl && <a class="join-pill" href={volunteerUrl} target="_blank" rel="noopener">Gönüllü ol</a>}

    <details class="nav-mobile">
      <summary aria-label="Menüyü aç">
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label="Mobil menü">
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Mobil menüde bir bağlantıya tıklanınca menüyü kapat.
  document.querySelectorAll<HTMLAnchorElement>('.nav-mobile a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--blue);
    color: #fff;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 72px;
  }
  .bar nav.nav-desktop { margin-left: auto; }
  .logo { background: #fff; border-radius: var(--bubble); padding: 4px 10px; transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1); }
  .logo:hover { transform: rotate(-4deg) scale(1.05); }
  .join-pill {
    background: var(--fire);
    color: var(--ink);
    font-weight: 750;
    text-decoration: none;
    padding: 9px 16px;
    border-radius: var(--bubble-r);
    transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .join-pill:hover { transform: rotate(3deg) scale(1.06); }
  .logo img { height: 46px; width: auto; }

  ul { list-style: none; margin: 0; padding: 0; }
  .nav-desktop ul { display: flex; gap: 4px; }
  .nav-desktop a {
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    padding: 8px 14px;
    border-radius: var(--bubble);
  }
  .nav-desktop a:hover { background: rgb(255 255 255 / 0.14); }
  .nav-desktop a[aria-current='page'] { background: #fff; color: var(--ink); }

  .nav-mobile { display: none; position: relative; color: var(--ink); }
  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: grid;
    place-content: center;
    gap: 5px;
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile summary span { display: block; width: 24px; height: 2px; background: #fff; border-radius: 2px; }
  .nav-mobile nav {
    position: absolute;
    right: 0;
    top: 52px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--bubble-r);
    box-shadow: 0 12px 32px rgb(23 32 74 / 0.14);
    padding: 8px;
    min-width: 220px;
  }
  .nav-mobile a {
    display: block;
    padding: 12px 14px;
    text-decoration: none;
    font-weight: 600;
    border-radius: 8px;
  }
  .nav-mobile a:hover { background: var(--mist); }

  @media (max-width: 860px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
    .join-pill { margin-left: auto; }
    .logo img { height: 38px; }
  }
</style>
