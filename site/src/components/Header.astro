---
import { t, anchor, routes, type Lang } from '../i18n';

interface Props { lang: Lang; switchHref: string }
const { lang, switchHref } = Astro.props;
const s = t[lang];
const links = [
  { href: anchor(lang, 'about'), label: s.nav.about },
  { href: anchor(lang, 'periods'), label: s.nav.periods },
  { href: routes.belgeler[lang], label: s.nav.belgeler },
  { href: routes.blog[lang], label: s.nav.blog },
  { href: routes.duyurular[lang], label: s.nav.duyurular },
  { href: anchor(lang, 'contact'), label: s.nav.contact },
];
const path = Astro.url.pathname;
const other = lang === 'tr' ? 'en' : 'tr';
---

<header class="header">
  <div class="wrap bar">
    <a href={routes.home[lang]} class="logo" aria-label={s.homeLabel}>
      <img src="/arsiv/gorseller/gy-logo.png" alt="Gençliğin Yüzleri" width="449" height="281" />
    </a>

    <nav aria-label={s.mainMenu} class="nav-desktop">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path === l.href || (l.href !== '/' && !l.href.includes('#') && path.startsWith(l.href + '/')) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="lang" href={switchHref} hreflang={other} lang={other} aria-label={s.switchTo}>{s.switchShort}</a>
    <a class="join-pill" href={routes.volunteer[lang]} aria-current={path === routes.volunteer[lang] ? 'page' : undefined}>{s.volunteer}</a>

    <details class="nav-mobile">
      <summary aria-label={s.openMenu}>
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label={s.mainMenu}>
        <ul>
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Mobil menüde bir bağlantıya tıklanınca menüyü kapat.
  document.querySelectorAll<HTMLAnchorElement>('.nav-mobile a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--blue);
    color: #fff;
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 72px;
  }
  .bar nav.nav-desktop { margin-left: auto; }
  .logo { background: #fff; border-radius: var(--bubble); padding: 4px 10px; transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1); }
  .logo:hover { transform: rotate(-4deg) scale(1.05); }
  .lang {
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    padding: 8px 10px;
    border: 2px solid rgb(255 255 255 / 0.6);
    border-radius: var(--bubble);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }
  .lang:hover { background: #fff; color: var(--ink); border-color: #fff; }
  .join-pill {
    background: var(--fire);
    color: var(--ink);
    font-weight: 750;
    text-decoration: none;
    padding: 9px 16px;
    border-radius: var(--bubble-r);
    transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .join-pill:hover { transform: rotate(3deg) scale(1.06); }
  .logo img { height: 46px; width: auto; }

  ul { list-style: none; margin: 0; padding: 0; }
  .nav-desktop ul { display: flex; gap: 4px; }
  .nav-desktop a {
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    padding: 8px 14px;
    border-radius: var(--bubble);
  }
  .nav-desktop a:hover { background: rgb(255 255 255 / 0.14); }
  .nav-desktop a[aria-current='page'] { background: #fff; color: var(--ink); }

  .nav-mobile { display: none; position: relative; color: var(--ink); }
  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: grid;
    place-content: center;
    gap: 5px;
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile summary span { display: block; width: 24px; height: 2px; background: #fff; border-radius: 2px; }
  .nav-mobile nav {
    position: absolute;
    right: 0;
    top: 52px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--bubble-r);
    box-shadow: 0 12px 32px rgb(23 32 74 / 0.14);
    padding: 8px;
    min-width: 220px;
  }
  .nav-mobile a {
    display: block;
    padding: 12px 14px;
    text-decoration: none;
    font-weight: 600;
    border-radius: 8px;
  }
  .nav-mobile a:hover { background: var(--mist); }

  @media (max-width: 1100px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
    .lang {
    color: #fff;
    font-weight: 800;
    text-decoration: none;
    padding: 8px 10px;
    border: 2px solid rgb(255 255 255 / 0.6);
    border-radius: var(--bubble);
    font-size: 0.9rem;
    letter-spacing: 0.02em;
  }
  .lang:hover { background: #fff; color: var(--ink); border-color: #fff; }
  .join-pill { margin-left: auto; }
    .logo img { height: 38px; }
  }
</style>
