---
import type { Belge } from '../lib/content';

interface Props { belge: Belge }
const { belge } = Astro.props;
---

<a class="doc" href={belge.fileUrl} target="_blank" rel="noopener">
  <span class="paper">
    {belge.cover
      ? <img src={belge.cover.url(480)} alt="" loading="lazy" width="396" height="560" />
      : <span class="placeholder">PDF</span>}
  </span>
  {belge.label && <span class="label">{belge.label}</span>}
  <span class="title">{belge.title}</span>
  <span class="visually-hidden">(PDF, yeni sekmede açılır)</span>
</a>

<style>
  .doc { display: flex; flex-direction: column; text-decoration: none; }
  .paper {
    display: block;
    aspect-ratio: 396 / 560;
    overflow: hidden;
    background: var(--paper);
    border-radius: 3px;
    box-shadow: 0 1px 0 var(--line), 0 0 0 1px var(--line);
    margin-bottom: 14px;
    transition: transform 0.2s ease;
  }
  .doc:hover .paper { transform: rotate(-1.5deg); }
  .paper img { width: 100%; height: 100%; object-fit: cover; }
  .placeholder { display: grid; place-items: center; height: 100%; font-weight: 800; color: var(--ink-soft); }
  .label { font-size: 0.9rem; color: var(--ink-soft); }
  .title { font-weight: 650; line-height: 1.3; }
  .doc:hover .title { text-decoration: underline; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .paper { transition: none; } .doc:hover .paper { transform: none; } }
</style>
