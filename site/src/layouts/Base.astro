---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const settings = await getSettings();
const siteName = 'Gençliğin Yüzleri';
const { title, description = settings.heroText, image } = Astro.props;
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} | ${settings.slogan}`;
const ogImage = new URL(image ?? settings.heroImages[0]?.url(1200) ?? '/arsiv/gorseller/gy-logo.png', Astro.site);

// İçerik panelden güncellendiğinde en geç bir dakikada sitede görünsün.
Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1d2240" />
  </head>
  <body>
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <Header />
    <main id="icerik">
      <slot />
    </main>
    <Footer settings={settings} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    background: var(--ink);
    color: #fff;
    padding: 10px 16px;
    border-radius: 8px;
  }
  .skip:focus { top: 12px; }
</style>
