---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSettings } from '../lib/content';
import { t, langFromPath, routes, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Bu sayfanın her dildeki adresi (dil seçici ve hreflang için). */
  paths?: Partial<Record<Lang, string>>;
  lang?: Lang;
}

const lang = Astro.props.lang ?? langFromPath(Astro.url.pathname);
const settings = await getSettings(lang);
const siteName = 'Gençliğin Yüzleri';
const { title, description = settings.heroText, image, paths = { tr: routes.home.tr, en: routes.home.en } } = Astro.props;
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} | ${settings.slogan}`;
const ogImage = new URL(image ?? settings.heroImages[0]?.url(1200) ?? '/arsiv/gorseller/gy-logo.png', Astro.site);

// İçerik panelden güncellendiğinde en geç bir dakikada sitede görünsün.
Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {Object.entries(paths).map(([l, p]) => <link rel="alternate" hreflang={l} href={new URL(p!, Astro.site)} />)}
    {paths.tr && <link rel="alternate" hreflang="x-default" href={new URL(paths.tr, Astro.site)} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t[lang].ogLocale} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#2448d8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#icerik">{t[lang].skip}</a>
    <Header lang={lang} volunteerUrl={settings.volunteerUrl} switchHref={paths[other] ?? routes.home[other]} />
    <main id="icerik">
      <slot />
    </main>
    <Footer lang={lang} settings={settings} />
    <script>
      // Kaydırınca beliren öğeler ve sıfırdan sayan rakamlar.
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const count = (el: HTMLElement) => {
        const raw = el.dataset.count ?? '';
        const m = raw.match(/^(\d+)(.*)$/);
        if (!m || calm) return;
        const target = Number(m[1]);
        const rest = m[2];
        const t0 = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / 1400);
          el.textContent = Math.round(target * (1 - Math.pow(1 - k, 3))) + rest;
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            el.classList.add('in');
            el.querySelectorAll<HTMLElement>('[data-count]').forEach(count);
            io.unobserve(el);
          }),
        { threshold: 0.2 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    background: var(--ink);
    color: #fff;
    padding: 10px 16px;
    border-radius: 8px;
  }
  .skip:focus { top: 12px; }
</style>
